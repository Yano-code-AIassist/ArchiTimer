<Window x:Class="ArchiTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArchiTimer"
        Title="ArchiTimer" Icon="Assets/ArchiTimer.ico" Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsCompact, Converter={StaticResource InverseBoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="#171A1D" Padding="24,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="ARCHI TIMER" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" FontSize="22" />
                        <TextBlock Text="設計と思考のための作業時計" Foreground="#9DA4A8" FontSize="12" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="#E8EDF0" BorderBrush="#B9C4CA" BorderThickness="1" CornerRadius="5"
                                Padding="10,6" Margin="8" VerticalAlignment="Center">
                            <CheckBox Content="常に手前" IsChecked="{Binding AlwaysOnTop}"
                                      Foreground="#172026" Background="#FFFFFF" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="コンパクト表示" Click="CompactButton_Click" />
                        <Button Content="{Binding TaskbarButtonLabel}" Click="TaskbarButton_Click"
                                ToolTip="実行中タイマーの経過時間または残り時間をWindowsタスクバーに表示します" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1" Margin="18" Background="Transparent">
                <TabItem Header="タイマー">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#E7ECEF" BorderBrush="#B8C3C9" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#172026" />
                                </Style>
                            </Border.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="新しい作業" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="作業名" Foreground="#AEB4B7" Margin="0,18,0,5" />
                                <TextBox Text="{Binding NewTimerName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="モード" Foreground="#AEB4B7" Margin="0,14,0,5" />
                                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
                                <TextBlock Text="通常タイマーの時間" Foreground="#AEB4B7" Margin="0,14,0,5" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding NewHours}" Width="62" />
                                    <TextBlock Text="時間" VerticalAlignment="Center" Margin="6,0,12,0" />
                                    <TextBox Text="{Binding NewMinutes}" Width="62" />
                                    <TextBlock Text="分" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="ポモドーロの時間" Foreground="#AEB4B7" Margin="0,14,0,5" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding NewPomodoroFocusMinutes}" Width="62" />
                                    <TextBlock Text="分 集中" VerticalAlignment="Center" Margin="6,0,12,0" />
                                    <TextBox Text="{Binding NewPomodoroBreakMinutes}" Width="62" />
                                    <TextBlock Text="分 休憩" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="ポモドーロの時間は1～999分で設定できます。ストップウォッチは0秒から積算し、通常タイマーは99時間以上も設定できます。"
                                           Foreground="#8F979B" TextWrapping="Wrap" FontSize="12" Margin="0,12" />
                                <Button Content="タイマーを開始" Command="{Binding AddTimerCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="#17130E" FontWeight="Bold" />
                                <Button Content="プリセットとして保存" Command="{Binding SavePresetCommand}" />
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#9A5100"
                                           TextWrapping="Wrap" Margin="4,12,4,0" />
                            </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,10">
                                <TextBlock Text="進行中の作業" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RunningSummary}" Foreground="#9DA4A8"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Timers}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#263640" BorderBrush="#3E5664" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#F7F9FA" />
                                                        <Border Background="#333A3F" CornerRadius="10" Padding="8,2" Margin="10,0">
                                                            <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="#C4C9CB" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayTime}" FontFamily="Consolas" FontSize="34"
                                                               Foreground="{StaticResource AccentBrush}" Margin="0,7,0,0" />
                                                    <TextBlock Text="{Binding StateLabel}" Foreground="#9DA4A8" FontSize="12" />
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Content="{Binding ToggleLabel}" Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button Content="作業完了" Background="{StaticResource AccentBrush}" Foreground="#17130E" Visibility="{Binding ShowFinish, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.FinishTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button Content="削除" Foreground="#FFB3AD" Command="{Binding DataContext.DeleteTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="プリセット">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,16" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="保存した作業プリセット" Foreground="#172026"
                                           FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="よく使う作業を、同じ設定ですぐに開始できます"
                                           Foreground="#66737A" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#E7ECEF" BorderBrush="#B8C3C9"
                                    BorderThickness="1" CornerRadius="12" Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Presets.Count, StringFormat='保存済み {0}件'}"
                                           Foreground="#445159" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Presets}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#26343C" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2B3B44" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            BorderBrush="#3E5664" BorderThickness="1" CornerRadius="10"
                                            Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Background="{StaticResource AccentBrush}" />

                                            <StackPanel Grid.Column="1" Margin="18,15,20,15" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F7F9FA"
                                                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Background="#303A40" BorderBrush="#536671" BorderThickness="1"
                                                            CornerRadius="10" Padding="9,2" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Mode}" Foreground="#D7DEE2"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Foreground="#AEB9BF"
                                                           FontSize="13" Margin="0,7,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="2" BorderBrush="#35464F" BorderThickness="1,0,0,0"
                                                    Padding="14,11" VerticalAlignment="Stretch">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="この設定で開始" Background="{StaticResource AccentBrush}"
                                                            Foreground="#17130E" FontWeight="Bold" Padding="15,8"
                                                            Command="{Binding DataContext.StartPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="削除" Background="Transparent" Foreground="#FFB3AD"
                                                            BorderBrush="#6B4949" BorderThickness="1" Padding="12,7"
                                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <TabItem Header="履歴">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="完了した作業" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="行をクリックまたはドラッグして、削除する履歴を選択できます"
                                           Foreground="#66737A" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="すべて選択" Click="SelectAllHistoryButton_Click" />
                                <Button Content="選択解除" Click="ClearHistorySelectionButton_Click" />
                                <Button x:Name="DeleteSelectedHistoryButton" Content="選択した履歴を削除"
                                        IsEnabled="False" Background="#6B3333" Foreground="#FFF2F0"
                                        Click="DeleteSelectedHistoryButton_Click" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                                  Background="{StaticResource PanelBrush}" Foreground="#1B1F22"
                                  RowBackground="#F7F9FA" AlternatingRowBackground="#E7ECEF" AlternationCount="2"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#CBD3D7"
                                  SelectionChanged="HistoryGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="HistoryGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="HistoryGrid_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="HistoryGrid_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="HistoryGrid_LostMouseCapture">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="#172026" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="#17130E" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="完了日時" Binding="{Binding CompletedAtLocal}" Width="180" />
                                <DataGridTextColumn Header="作業" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="150" />
                                <DataGridTextColumn Header="合計時間" Binding="{Binding DurationLabel}" Width="110" />
                                <DataGridTextColumn Header="作業時間" Binding="{Binding WorkDurationLabel}" Width="110" />
                                <DataGridTextColumn Header="休憩時間" Binding="{Binding BreakDurationLabel}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Visibility="{Binding IsCompact, Converter={StaticResource BoolVisibility}}"
                Background="#161A1D" BorderBrush="#3E464B" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="ARCHI TIMER" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                    <Button DockPanel.Dock="Right" Content="戻す" Padding="8,3" Click="CompactButton_Click" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Timers}" Margin="0,6,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right" FontFamily="Consolas"
                                           Foreground="{StaticResource AccentBrush}" FontSize="16" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
